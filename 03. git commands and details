git checkout -b feat/CGC-0000/this-is-my-first-commit
git checkout <commit id>   #if you want to switch to lower commit id and undo changes


// git commmit
git commit -m "this is my first commit"
or git commit -m "feat(CW):CGC:0000 this is my first commit"



// git log
git log
git log --oneline
git show <commit id>

git reflog   # provides complete details where to where what done

