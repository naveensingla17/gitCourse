// Linux
yum install git -y 

//ubuntu
apt install git

// git version
git --version

// git add --> to move file to stage area
git add . ## all files
git add filename
git add -A

// undo command to move back to working director i.e untracked
git rm --cached
git revert
git restore

//git checkout
git checkout -b feat/CGC-0000/this-is-my-first-commit


// git commmit
git commit -m "this is my first commit"
or git commit -m "feat(CW):CGC:0000 this is my first commit"



// git log
git log
git log --oneline
git show <commit id>
